  "db_name": "PostgreSQL",
  "query": "\n            SELECT d.id, d.user_id AS \"user_id: UserId\", u.username,\n                   d.paired_by AS \"paired_by: UserId\", d.created_at\n            FROM tv_devices d\n            JOIN users u ON u.id = d.user_id\n            WHERE d.room_id = $1 AND d.revoked_at IS NULL\n            ORDER BY d.created_at DESC\n            ",
